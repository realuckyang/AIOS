[
  {
    "name": "read",
    "description": "读取本机 UTF-8 文本文件。路径可相对当前工作目录或使用绝对路径；可按行截取。",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "用一句简短的中文说明概括这次读取的目的，供界面展示"
        },
        "path": {
          "type": "string",
          "description": "文件路径"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1,
          "description": "起始行，默认 1"
        },
        "line_count": {
          "type": "integer",
          "minimum": 1,
          "description": "最多返回多少行；默认读取到文件末尾"
        }
      },
      "required": [
        "summary",
        "path"
      ],
      "additionalProperties": false
    },
    "exec": "bin/tools/read"
  },
  {
    "name": "write",
    "description": "创建或完整覆盖本机 UTF-8 文本文件；父目录不存在时自动创建。",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "用一句简短的中文说明概括这次写入的目的，供界面展示"
        },
        "path": {
          "type": "string",
          "description": "文件路径"
        },
        "content": {
          "type": "string",
          "description": "要写入的完整内容"
        }
      },
      "required": [
        "summary",
        "path",
        "content"
      ],
      "additionalProperties": false
    },
    "exec": "bin/tools/write"
  },
  {
    "name": "edit",
    "description": "在 UTF-8 文本文件中精确替换文本。默认要求 old_text 只出现一次；replace_all=true 时替换全部。",
    "parameters": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "description": "用一句简短的中文说明概括这次修改的目的，供界面展示"
        },
        "path": {
          "type": "string",
          "description": "文件路径"
        },
        "old_text": {
          "type": "string",
          "description": "必须精确匹配的原文本"
        },
        "new_text": {
          "type": "string",
          "description": "替换后的文本"
        },
        "replace_all": {
          "type": "boolean",
          "description": "是否替换所有匹配，默认 false"
        }
      },
      "required": [
        "summary",
        "path",
        "old_text",
        "new_text"
      ],
      "additionalProperties": false
    },
    "exec": "bin/tools/edit"
  },
  {
    "name": "browserctl",
    "description": "通过 AIOS Browser Control 扩展控制本机 Chrome 浏览器，同步返回结果。支持 action: getTabInfo(读取当前活动标签的标题/URL)、listTabs(列出所有标签页)、navigate(跳转标签到 url)、run(在当前页面执行一段 JS 并返回结果)。会等待扩展执行完成后一次性返回。",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "getTabInfo",
            "listTabs",
            "navigate",
            "run"
          ],
          "description": "要执行的操作"
        },
        "url": {
          "type": "string",
          "description": "navigate 时跳转的 URL"
        },
        "code": {
          "type": "string",
          "description": "run 时在页面执行的 JS 代码"
        },
        "wait_sec": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300,
          "description": "等待结果的最长秒数，默认 60"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "exec": "bin/tools/browserctl"
  }
]
