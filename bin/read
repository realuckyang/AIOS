#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const reply = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);

try {
  const input = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
  if (typeof input.path !== 'string' || !input.path) throw new Error('path 必须是非空字符串');
  const file = path.resolve(process.cwd(), input.path);
  const content = fs.readFileSync(file, 'utf8');
  const lines = content.split('\n');
  const start = Number.isInteger(input.start_line) ? Math.max(1, input.start_line) : 1;
  const count = Number.isInteger(input.line_count) ? Math.max(1, input.line_count) : lines.length;
  reply({ ok: true, path: file, start_line: start, content: lines.slice(start - 1, start - 1 + count).join('\n') });
} catch (err) {
  reply({ ok: false, error: String(err?.message ?? err) });
  process.exitCode = 1;
}
