#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const reply = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);

try {
  const input = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
  if (typeof input.pattern !== 'string' || !input.pattern) throw new Error('pattern 必须是非空字符串');
  const root = path.resolve(process.cwd(), typeof input.path === 'string' ? input.path : '.');
  if (!fs.existsSync(root)) throw new Error(`路径不存在: ${root}`);

  const flags = input.ignore_case ? 'i' : '';
  const re = new RegExp(input.pattern, flags);
  const max = Number.isInteger(input.max_results) && input.max_results > 0 ? input.max_results : 100;
  const skipDirs = new Set(['node_modules', '.git', 'dist', 'build', 'var', 'run', '.dev']);

  const results = [];
  const walk = (dir) => {
    if (results.length >= max) return;
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      if (results.length >= max) return;
      if (entry.name.startsWith('.')) continue;
      const full = path.join(dir, entry.name);
      if (entry.isDirectory()) {
        if (!skipDirs.has(entry.name)) walk(full);
      } else if (entry.isFile()) {
        try {
          const stat = fs.statSync(full);
          if (stat.size > 5 * 1024 * 1024) continue; // 跳过 >5MB 文件
          const content = fs.readFileSync(full, 'utf8');
          const lines = content.split('\n');
          for (let i = 0; i < lines.length; i++) {
            if (re.test(lines[i])) {
              results.push({ file: full, line: i + 1, text: lines[i].slice(0, 300) });
              if (results.length >= max) return;
            }
          }
        } catch { /* 二进制或不可读文件跳过 */ }
      }
    }
  };

  walk(root);
  reply({ ok: true, pattern: input.pattern, root, count: results.length, results });
} catch (err) {
  reply({ ok: false, error: String(err?.message ?? err) });
  process.exitCode = 1;
}
