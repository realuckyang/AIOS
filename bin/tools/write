#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const reply = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);

try {
  const input = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
  if (typeof input.path !== 'string' || !input.path) throw new Error('path 必须是非空字符串');
  if (typeof input.content !== 'string') throw new Error('content 必须是字符串');
  const file = path.resolve(process.cwd(), input.path);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, input.content, 'utf8');
  reply({ ok: true, path: file, bytes: Buffer.byteLength(input.content) });
} catch (err) {
  reply({ ok: false, error: String(err?.message ?? err) });
  process.exitCode = 1;
}
