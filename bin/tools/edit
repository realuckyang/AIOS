#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';

const reply = (value) => process.stdout.write(`${JSON.stringify(value)}\n`);

try {
  const input = JSON.parse(fs.readFileSync(0, 'utf8') || '{}');
  if (typeof input.path !== 'string' || !input.path) throw new Error('path 必须是非空字符串');
  if (typeof input.old_text !== 'string' || !input.old_text) throw new Error('old_text 必须是非空字符串');
  if (typeof input.new_text !== 'string') throw new Error('new_text 必须是字符串');

  const file = path.resolve(process.cwd(), input.path);
  const content = fs.readFileSync(file, 'utf8');
  const matches = content.split(input.old_text).length - 1;
  if (matches === 0) throw new Error('old_text 未在文件中找到');
  if (!input.replace_all && matches !== 1) throw new Error(`old_text 出现 ${matches} 次；请提供更精确的文本或设置 replace_all=true`);

  const updated = input.replace_all
    ? content.split(input.old_text).join(input.new_text)
    : content.replace(input.old_text, input.new_text);
  fs.writeFileSync(file, updated, 'utf8');
  reply({ ok: true, path: file, replacements: input.replace_all ? matches : 1 });
} catch (err) {
  reply({ ok: false, error: String(err?.message ?? err) });
  process.exitCode = 1;
}
