#!/usr/bin/env node
// 框架/应用边界的复核。App 启动时跑一次,越界就报出来。
//
// 老 AIOS 把「应用建自己的库」当约定,结果主库里混进了 notes、cc_conversations、
// cc_events —— 谁想往主库塞都塞得进。这一版把它变成可检查的事实:
// apps/ 下不许出现通往框架库或框架仓库的 import。
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../..');
const APPS = path.join(ROOT, 'app', 'apps');

// 应用不得触碰的东西:框架库的句柄,和框架自己的仓库层。
const FORBIDDEN = [
  { re: /from\s+['"][^'"]*main\/server\/db[^'"]*['"]/, why: '框架库 var/aios.db —— 应用应当用 _shared/db.js 开自己的库' },
  { re: /from\s+['"][^'"]*main\/server\/repository[^'"]*['"]/, why: '框架仓库层 —— 应用要框架数据请走 HTTP API' },
  { re: /from\s+['"][^'"]*main\/server\/service[^'"]*['"]/, why: '框架服务层 —— 应用调模型请走 _shared/task.js' },
];

function* files(dir) {
  let entries;
  try { entries = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
  for (const entry of entries) {
    if (entry.name === 'node_modules' || entry.name === 'dist') continue;
    const full = path.join(dir, entry.name);
    if (entry.isDirectory()) yield* files(full);
    else if (/\.(js|ts|tsx)$/.test(entry.name)) yield full;
  }
}

const violations = [];
for (const file of files(APPS)) {
  const text = fs.readFileSync(file, 'utf8');
  text.split('\n').forEach((line, i) => {
    for (const rule of FORBIDDEN) {
      if (rule.re.test(line)) {
        violations.push(`${path.relative(ROOT, file)}:${i + 1} 越界访问${rule.why}\n    ${line.trim()}`);
      }
    }
  });
}

if (violations.length) {
  console.error(`[boundaries] 应用越过了框架边界(${violations.length} 处):`);
  for (const v of violations) console.error(`  ${v}`);
  process.exit(1);
}
console.log('[boundaries] 应用与框架边界干净');
