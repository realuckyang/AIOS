#!/usr/bin/env bash
# 预装 libc:内核 API 的 curl 包装。agent 可改、可增,自产自销。
# 用法:
#   agent-cli chats                          列出对话
#   agent-cli new <title> [task]             创建对话(带任务则立即运行,source=runtime)
#   agent-cli send <chat> <text> [source]    发消息(默认 source=runtime)
#   agent-cli items <chat>                   读消息(直读走文件更好,这是 API 兜底)
#   agent-cli meta <chat>                    读对话信息
#   agent-cli stop <chat>                    停止运行
#   agent-cli rm <chat>                      删除对话
#   agent-cli forget <chat> <seq>            拨上下文指针(遗忘 seq 及之前)
set -euo pipefail
API="${KERNEL_API:-http://127.0.0.1:${KERNEL_PORT:-9600}/api}"

json_escape() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

case "${1:-}" in
  chats)  curl -sf "$API/chats" ;;
  new)
    title=$(json_escape "${2:?用法: agent-cli new <title> [task]}")
    if [ -n "${3:-}" ]; then
      task=$(json_escape "$3")
      curl -sf -X POST "$API/chats" -d "{\"title\":$title,\"message\":{\"content\":$task,\"source\":\"runtime\"}}"
    else
      curl -sf -X POST "$API/chats" -d "{\"title\":$title}"
    fi ;;
  send)
    text=$(json_escape "${3:?用法: agent-cli send <chat> <text> [source]}")
    curl -sf -X POST "$API/chats/${2}/messages" -d "{\"content\":$text,\"source\":\"${4:-runtime}\"}" ;;
  items)  curl -sf "$API/chats/${2:?缺 chat id}/items" ;;
  meta)   curl -sf "$API/chats/${2:?缺 chat id}" ;;
  stop)   curl -sf -X POST "$API/chats/${2:?缺 chat id}/stop" ;;
  rm)     curl -sf -X DELETE "$API/chats/${2:?缺 chat id}" ;;
  forget) curl -sf -X PATCH "$API/chats/${2:?缺 chat id}" -d "{\"context_start\":${3:?缺 seq}}" ;;
  *)      grep '^#   agent-cli' "$0" | sed 's/^#   //'; exit 1 ;;
esac
echo
